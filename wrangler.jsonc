{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "english-recall-hub",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
